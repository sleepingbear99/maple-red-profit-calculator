# Public browser configuration. These values are safe to expose in the built site.
# Never place SUPABASE_SERVICE_ROLE_KEY or the administrator PIN in a VITE_ variable.
# Static deployments must provide both values during the production build.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
